# --- core ---
# SQLite (default; persisted in ./data). For Postgres:
# DATABASE_URL=postgresql+asyncpg://tcg:tcg@db:5432/tcg
DATABASE_URL=sqlite+aiosqlite:///./data/tcg_tracker.db
TIMEZONE=Europe/Berlin
LOG_LEVEL=INFO
LOG_FORMAT=console   # console | json

# --- dashboard (EXPOSED ON YOUR VPS -> set strong values!) ---
SECRET_KEY=generate-a-long-random-string
DASHBOARD_PASSWORD=pick-a-strong-password
# Optional bearer token for API/scripting access
# DASHBOARD_TOKEN=

# --- Discord webhooks (create per channel: Server Settings -> Integrations) ---
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_POKEMON=
DISCORD_WEBHOOK_URL_ONEPIECE=
DISCORD_WEBHOOK_URL_NEWS=

# --- Shop-Discovery Websuche: optionaler Brave-Search-API-Key
# (kostenloses Kontingent: https://brave.com/search/api/). Ohne Key nutzt
# die Suche den DuckDuckGo-HTML-Fallback (sparsam, alle 6h). ---
# BRAVE_API_KEY=

# --- Cardmarket API (https://api.cardmarket.com -> create an app) ---
CARDMARKET_APP_TOKEN=
CARDMARKET_APP_SECRET=
CARDMARKET_ACCESS_TOKEN=
CARDMARKET_ACCESS_SECRET=

# Restock-Alarme enthalten "Auch checken"-Suchlinks zu den anderen großen Shops
# SHOW_OTHER_SHOPS=true

# Tägliche "Tracker läuft"-Statusnachricht (24h-Statistik + hängende Watches)
# HEARTBEAT_ENABLED=true
# HEARTBEAT_HOUR=9

# Ruhezeit: nicht-wichtige Pings werden in diesem Fenster unterdrückt
# (Watches/Scanner mit "Wichtig"-Haken kommen immer durch). Format "22-7".
# QUIET_HOURS=

# --- optional fetching tweaks ---
# PROXY_URL=http://user:pass@proxy:8080
# PER_DOMAIN_CONCURRENCY=1
# RESPECT_ROBOTS_TXT=true
# DEFAULT_POLL_INTERVAL_SECONDS=300
# DEFAULT_COOLDOWN_SECONDS=1800
# NEWS_POLL_INTERVAL_SECONDS=1800
# RELEASE_SOON_LEAD_DAYS=7

# --- stubs (wire up when implementing email/telegram notifiers) ---
# SMTP_HOST= / SMTP_PORT=587 / SMTP_USER= / SMTP_PASSWORD= / SMTP_FROM= / SMTP_TO=
# TELEGRAM_BOT_TOKEN= / TELEGRAM_CHAT_ID=
