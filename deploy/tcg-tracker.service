# Bare-metal systemd unit (alternative to Docker) for a Hetzner VPS.
#
# Setup:
#   sudo useradd -r -m -d /opt/tcg-tracker tcg
#   sudo -u tcg git clone <repo> /opt/tcg-tracker/app
#   cd /opt/tcg-tracker/app
#   sudo -u tcg python3.12 -m venv .venv
#   sudo -u tcg .venv/bin/pip install ".[playwright]"     # or plain "."
#   sudo -u tcg .venv/bin/playwright install --with-deps chromium   # optional
#   sudo -u tcg cp .env.example .env && sudo -u tcg cp config.example.yaml config.yaml
#   # edit .env + config.yaml, then:
#   sudo cp deploy/tcg-tracker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tcg-tracker
#
# Logs: journalctl -u tcg-tracker -f

[Unit]
Description=TCG Tracker (Pokemon/One Piece stock monitor + news)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tcg
WorkingDirectory=/opt/tcg-tracker/app
EnvironmentFile=/opt/tcg-tracker/app/.env
ExecStart=/opt/tcg-tracker/app/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tcg-tracker/app/data

[Install]
WantedBy=multi-user.target
